{
  "name": "gpt-memory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gpt-memory-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gpt-memory-db",
    "db:seed:local": "wrangler d1 execute gpt-memory-db --local --file=src/database/seeds/seed.sql",
    "db:seed:remote": "wrangler d1 execute gpt-memory-db --file=src/database/seeds/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.16.0",
    "@scalar/hono-api-reference": "^0.5.153",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^4.20240725.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.24.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
